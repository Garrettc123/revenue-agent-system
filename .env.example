# Revenue Agent System - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Configuration
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://revenue_user:changeme123@postgres:5432/revenue_db
POSTGRES_PASSWORD=changeme123

# MongoDB Configuration
MONGODB_PASSWORD=changeme123
MONGODB_URI=mongodb://admin:changeme123@mongodb:27017

# Payment Integration - Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
# Required: /webhooks/stripe rejects events when this is unset
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redis Cache Configuration
# Defaults to localhost; docker-compose sets REDIS_HOST=redis.
# When Redis is unreachable the app falls back to a per-process in-memory cache.
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring & Observability
GRAFANA_PASSWORD=admin123

# External APIs
OPENAI_API_KEY=sk-your_openai_key
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
